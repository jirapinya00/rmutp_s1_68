generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String  @id @default(uuid())
  username  String  @unique                
  password  String  @db.VarChar(255)       
  cardId    String  @db.Text               
  mobile    String  @db.Text                
  status    Boolean
}


